#!/bin/sh
# House pre-commit hook: blocks the commit if House rejects the staged changes.
#
# Install: cp docs/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Tier:    HOUSE_TIER=fast (default) | standard | adversarial
# Bypass:  HOUSE_BYPASS=1 git commit ...   (logged by the post-commit hook)

if [ "$HOUSE_BYPASS" = "1" ]; then
    echo "House: HOUSE_BYPASS=1, review skipped (the post-commit hook logs it)." >&2
    exit 0
fi

# Pick an interpreter that can import everybody_lies (Windows may have a
# python3 stub without the package next to the real python).
for p in python3 python py; do
    if command -v "$p" >/dev/null 2>&1 && "$p" -c "import everybody_lies" >/dev/null 2>&1; then
        exec "$p" -m everybody_lies --staged --tier "${HOUSE_TIER:-fast}"
    fi
done

echo "House: everybody_lies is not importable; install it with: pip install everybody-lies" >&2
exit 1
