#!/bin/sh
# House post-commit hook: records bypassed commits in House's audit log
# (~/.everybody-lies/reviews/house-commits.jsonl).
#
# Install: cp docs/hooks/post-commit .git/hooks/post-commit && chmod +x .git/hooks/post-commit

[ "$HOUSE_BYPASS" = "1" ] || exit 0
sha=$(git rev-parse HEAD) || exit 0
for p in python3 python py; do
    if command -v "$p" >/dev/null 2>&1 && "$p" -c "import everybody_lies" >/dev/null 2>&1; then
        exec "$p" -m everybody_lies --log-bypass "$sha" --bypass-reason "${HOUSE_BYPASS_REASON:-unspecified}"
    fi
done
exit 0
