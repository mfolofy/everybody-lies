#!/bin/sh
# House pre-push scope enforcement hook.
# Install: cp docs/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Checks pushed files against .house/patients.json per-remote scope policy.
# Unknown remotes are blocked by default. HOUSE_BYPASS=1 skips (bypass_protected remotes excepted).

REMOTE="$1"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

if [ -z "$REPO_ROOT" ]; then
  echo "[HOUSE] WARNING: could not determine repo root — pre-push check skipped" >&2
  exit 0
fi

# Try python first (has real packages on Windows), then python3 as fallback.
# Validates the chosen Python can actually import everybody_lies.
PYTHON=""
for candidate in python python3; do
  PYTHON="$(command -v "$candidate" 2>/dev/null)"
  if [ -n "$PYTHON" ] && "$PYTHON" -c "import everybody_lies" 2>/dev/null; then
    break
  fi
  PYTHON=""
done

if [ -z "$PYTHON" ]; then
  echo "[HOUSE] WARNING: everybody_lies not installed — pre-push scope check skipped" >&2
  exit 0
fi

# Pass all stdin (refspecs from git) to the Python checker
"$PYTHON" -m everybody_lies --pre-push --remote "$REMOTE"
